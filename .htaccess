# Sem listagem de pastas
Options -Indexes

# www -> domínio principal (evita conteúdo duplicado no Google)
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Private hub, OAuth discovery, and retirement of the old .page application.
  RewriteRule ^(?:scripts|tests|node_modules|\.private)(?:/|$) - [F,L]
  RewriteRule ^\.(?!well-known/) - [F,L]
  RewriteRule ^\.well-known/(?:oauth-protected-resource|oauth-authorization-server)(?:/.*)?$ controlevida/metadata.php [L,QSA]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?marcosmedeiros\.page$ [NC]
  RewriteRule ^$ /controlevida/ [R=302,L]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?marcosmedeiros\.page$ [NC]
  RewriteRule ^(?:api[^/]*\.php|app_api\.php|mcp\.php|ai_chat\.php|calendar_feed\.php|config\.php|secrets\.php|indexvelho\.php|app(?:\.php|\.html|/.*)?|includes/.*|mcp-server/.*|php_error\.log)$ - [F,L]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# Tipos
AddType application/manifest+json .webmanifest

# Compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml text/plain application/xml application/manifest+json
</IfModule>

# Cache de arquivos estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

# O deploy via Git coloca a pasta .git no public_html: bloquear acesso público
RedirectMatch 404 /\.git
