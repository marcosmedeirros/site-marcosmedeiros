Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Server code, development tooling and private data are never served.
  RewriteRule ^(?:server|scripts|tests|docs|node_modules)(?:/|$) - [F,L]
  # OAuth discovery for MCP clients that look under the app path.
  RewriteRule ^\.well-known/(?:oauth-protected-resource|oauth-authorization-server|openid-configuration)(?:/.*)?$ metadata.php [L,QSA]
  RewriteRule (?:^|/)\. - [F,L]
  RewriteRule ^(?:package(?:-lock)?\.json|README\.md)$ - [F,L]
  RewriteRule (?:\.sqlite|\.log$|(?:^|/)error_log$) - [F,L]
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  # The host swaps PHP's policy for a bare "upgrade-insecure-requests"; restate the app policy here.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; upgrade-insecure-requests"
  <Files "oauth.php">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; upgrade-insecure-requests"
  </Files>
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
